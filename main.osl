import "std:serve"
import "std:fs"
import "std:json"

auto r = serve.new()

r.use(serve.corsOpen())
r.use(serve.logger())

r.GET("/tlds", def(*serve.Context c) -> (
  string tlds = fs.readFile("tlds.json")
  object parsed = json.parse<object>(tlds) catch (
	c.string(500, "Unable to parse tlds.json")
	return
  )
  c.json(200, parsed)
))

r.run(":3164")

